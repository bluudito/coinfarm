-- ================= CLOSE SCRIPT ================= --
local function CloseScript()
    if not ScriptActive then return end
    ScriptActive = false

    FlingActive               = false
    State.CoinFarmEnabled     = false
    State.AutoKillAllEnabled  = false
    State.KillAllButtonMode   = false
    State.ESPEnabled          = false
    State.AntiAfkEnabled      = false
    State.AntiFlingEnabled    = false

    StopFling()
    StopAntiFling()
    setNoclip(false)

    if antiAfkConn then antiAfkConn:Disconnect() antiAfkConn = nil end
    if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end

    for _, conn in ipairs(connections) do
        if conn and conn.Disconnect then conn:Disconnect() end
    end

    for _, bConn in pairs(blacklistConns) do
        if bConn then bConn:Disconnect() end
    end
    blacklistConns = {}

    ClearESP()

    if reusableBodyVel then reusableBodyVel:Destroy() reusableBodyVel = nil end

    local c = LocalPlayer.Character
    if c then
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Anchored = false
            if (wasFarming) and State.GameState ~= "Lobby" then
                if lastSafeCFrame then
                    hrp.CFrame = lastSafeCFrame
                else
                    hrp.CFrame = hrp.CFrame + Vector3.new(0, 7, 0)
                end
            end
        end

        for _, part in ipairs(c:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = savedCollisions[part] ~= nil and savedCollisions[part] or true
            end
        end
        savedCollisions = {}

        local humanoid = c:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        end
    end

    wasFarming = false
    DestroyKillCircle()
    Window:Destroy()
end

