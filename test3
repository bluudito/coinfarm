--// ===== Noclip (continuous Stepped loop) =====
local function setNoclip(enabled)
    if enabled and not noclipConnection then
        noclipActive = true
        noclipConnection = RunService.Stepped:Connect(function()
            if not noclipActive then return end
            local char = player.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    elseif not enabled and noclipConnection then
        noclipActive = false
        noclipConnection:Disconnect()
        noclipConnection = nil
        local char = player.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end

--// ===== Coin helpers =====
local function getCoinPositions()
    local coins = {}
    if not CURRENT_MAP_NAME then return coins end

    local map = workspace:FindFirstChild(CURRENT_MAP_NAME)
    if not map then return coins end

    local coinContainer = map:FindFirstChild(COIN_CONTAINER_NAME)
    if not coinContainer then return coins end

    for _, coin in ipairs(coinContainer:GetChildren()) do
        local pos
        if coin:IsA("BasePart") then
            pos = coin.Position
        elseif coin:IsA("Model") then
            if coin.PrimaryPart then
                pos = coin.PrimaryPart.Position
            else
                local ok, cframe = pcall(function() return coin:GetPivot() end)
                if ok then pos = cframe.Position end
            end
        end
        if pos then
            table.insert(coins, { instance = coin, position = pos })
        end
    end

    return coins
end

local function roundIsOver()
    if not player:GetAttribute("Alive") then return true end
    if CURRENT_MAP_INSTANCE and not CURRENT_MAP_INSTANCE:IsDescendantOf(workspace) then return true end
    return false
end

local function cleanupCharacterState()
    setNoclip(false)
    local character = player.Character
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Anchored = false
            hrp.CanCollide = true
        end
    end
    if reusableBodyVel then
        reusableBodyVel:Destroy()
        reusableBodyVel = nil
    end
end

--// ===== Map / spawn helpers =====
local function findCurrentMap()
    for _, name in ipairs(MAP_NAMES) do
        local map = workspace:FindFirstChild(name)
        if map then return map end
    end
    return nil
end

local function teleportToMapSpawn(map)
    local spawnsFolder = map:FindFirstChild(SPAWNS_FOLDER_NAME)
    if not spawnsFolder then return end

    local spawnParts = spawnsFolder:GetChildren()
    if #spawnParts == 0 then return end

    local chosen = spawnParts[math.random(1, #spawnParts)]
    local character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart")

    local spawnCFrame
    if chosen:IsA("BasePart") then
        spawnCFrame = chosen.CFrame
    elseif chosen:IsA("Model") then
        spawnCFrame = chosen.PrimaryPart and chosen.PrimaryPart.CFrame or chosen:GetPivot()
    end

    if spawnCFrame then
        hrp.CFrame = spawnCFrame + Vector3.new(0, 3, 0)
    end
end

--// ===== Coin farming (nearest, reusable mover, firetouchinterest, anti‑hang) =====
local function farmCoinsOnce(myLoopId, attemptedCoins)
    local coins = getCoinPositions()
    if #coins == 0 then return nil end

    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    -- Remove leftover holding BodyPosition
    for _, v in ipairs(hrp:GetChildren()) do
        if v:IsA("BodyPosition") then v:Destroy() end
    end

    -- Create or reuse BodyVelocity
    if not reusableBodyVel or not reusableBodyVel:IsDescendantOf(hrp) then
        reusableBodyVel = Instance.new("BodyVelocity")
        reusableBodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        reusableBodyVel.Velocity = Vector3.zero
        reusableBodyVel.Parent = hrp
    end
    local bodyVel = reusableBodyVel
    bodyVel.Velocity = Vector3.zero

    -- Find nearest un‑attempted coin
    local nearestCoin = nil
    local nearestDist = math.huge
    for _, coinData in ipairs(coins) do
        if coinData.instance and coinData.instance:IsDescendantOf(workspace) then
            if not attemptedCoins[coinData.instance] then
                local dist = (coinData.position - hrp.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearestCoin = coinData
                end
            end
        end
    end

    if not nearestCoin then
        -- No target; yield to avoid CPU hammering
        task.wait(COIN_POLL_DELAY)
        return nil
    end

    local currentCoin = nearestCoin.instance
    local targetPos = Vector3.new(nearestCoin.position.X, nearestCoin.position.Y + Y_OFFSET, nearestCoin.position.Z)

    -- Fly toward coin
    local startTime = tick()
    while true do
        if not active or not scriptActive or myLoopId ~= currentLoopId then return nil end
        if roundIsOver() then return "died" end
        if not currentCoin:IsDescendantOf(workspace) then break end

        local direction = targetPos - hrp.Position
        local distance = direction.Magnitude
        if distance < 0.5 then
            bodyVel.Velocity = Vector3.zero
            break
        end

        bodyVel.Velocity = direction.Unit * WALKSPEED
        if tick() - startTime > (distance / WALKSPEED) + 3 then
            bodyVel.Velocity = Vector3.zero
            break
        end
        task.wait()
    end

    bodyVel.Velocity = Vector3.zero
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    -- Hold position if cooldown > 0
    local holdPos = nil
    if COOLDOWN_DELAY > 0 then
        holdPos = Instance.new("BodyPosition")
        holdPos.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        holdPos.P = 10000
        holdPos.D = 500
        holdPos.Position = targetPos
        holdPos.Parent = hrp
        task.wait(0.1)   -- settle
    end

    if not active or not scriptActive or myLoopId ~= currentLoopId then
        if holdPos then holdPos:Destroy() end
        return nil
    end
    if roundIsOver() then
        if holdPos then holdPos:Destroy() end
        return "died"
    end

    -- Fire touch interest
    if currentCoin:IsDescendantOf(workspace) then
        firetouchinterest(hrp, currentCoin, 0)
        task.wait(0.05)
        firetouchinterest(hrp, currentCoin, 1)
    end

    attemptedCoins[currentCoin] = true

    -- Cooldown wait
    if COOLDOWN_DELAY > 0 then
        local waited = 0
        while waited < COOLDOWN_DELAY do
            if not active or not scriptActive or myLoopId ~= currentLoopId then
                if holdPos then holdPos:Destroy() end
                return nil
            end
            if roundIsOver() then
                if holdPos then holdPos:Destroy() end
                return "died"
            end
            task.wait(0.1)
            waited = waited + 0.1
        end
        holdPos:Destroy()
    end

    return nil
end

--// ===== Alive attribute wait =====
local function waitForAliveAttributeToExist()
    while scriptActive and player:GetAttribute("Alive") == nil do
        warn("[CoinTP] Alive attribute not found yet, checking again in " .. ALIVE_ATTR_CHECK_DELAY .. "s")
        task.wait(ALIVE_ATTR_CHECK_DELAY)
    end
end

--// ===== Main state loop =====
local function runSequence()
    currentLoopId = currentLoopId + 1
    local myLoopId = currentLoopId

    task.spawn(function()
        waitForAliveAttributeToExist()

        while active and scriptActive and myLoopId == currentLoopId do
            -- PHASE 1: LOBBY
            warn("[CoinTP] Entered LOBBY, waiting for Alive")
            while active and scriptActive and not player:GetAttribute("Alive") do
                player:GetAttributeChangedSignal("Alive"):Wait()
            end
            if not active or not scriptActive or myLoopId ~= currentLoopId then break end

            -- PHASE 2: ROUND_STARTING
            warn("[CoinTP] Alive detected, waiting " .. ALIVE_WAIT_TIME .. "s before map search")
            task.wait(ALIVE_WAIT_TIME)
            if not active or not scriptActive or myLoopId ~= currentLoopId then break end

            if player:GetAttribute("Alive") then
                local map = nil
                while active and scriptActive and myLoopId == currentLoopId do
                    if not player:GetAttribute("Alive") then break end
                    map = findCurrentMap()
                    if map then break end
                    task.wait(MAP_SEARCH_RETRY_DELAY)
                end

                if map and player:GetAttribute("Alive") then
                    CURRENT_MAP_NAME = map.Name
                    CURRENT_MAP_INSTANCE = map
                    warn("[CoinTP] Map detected: " .. CURRENT_MAP_NAME)
                    teleportToMapSpawn(map)
                    setNoclip(true)

                    -- PHASE 3: FARMING
                    warn("[CoinTP] Farming started")
                    local attemptedCoins = {}
                    local diedFlag = false
                    while active and scriptActive and myLoopId == currentLoopId do
                        if roundIsOver() then
                            diedFlag = true
                            break
                        end

                        local coinPositions = getCoinPositions()
                        if #coinPositions == 0 then
                            task.wait(COIN_POLL_DELAY)
                        else
                            local result = farmCoinsOnce(myLoopId, attemptedCoins)
                            if result == "died" then
                                diedFlag = true
                                break
                            end
                            if result == nil then
                                -- No target found; wait to prevent tight loop
                                task.wait(COIN_POLL_DELAY)
                            end
                        end
                    end

                    -- PHASE 4: CLEANUP
                    warn("[CoinTP] Round ended, cleaning up")
                    cleanupCharacterState()
                    CURRENT_MAP_NAME = nil
                    CURRENT_MAP_INSTANCE = nil
                end
            end
        end
    end)
end

