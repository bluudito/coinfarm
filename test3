local function buildLookupMaps()
    local db = ReplicatedStorage:FindFirstChild("Database")
    local sync = db and db:FindFirstChild("Sync")
    if not sync then return end
    local ok, data = pcall(require, sync)
    if not ok or type(data) ~= "table" then return end

    local weaponData = data.Weapons or data.Item
    if weaponData then
        for gameId, item in pairs(weaponData) do
            if type(item) == "table" then
                weaponKeyMap[gameId] = {
                    name   = tostring(item.ItemName or item.Name or ""),
                    itype  = tostring(item.ItemType or item.Type or "Unknown"),
                    rarity = tostring(item.Rarity or "Unknown"),
                    year   = tostring(item.Year or ""),
                    chroma = item.Chroma == true
                }
            end
        end
    end

    if data.Pets then
        for gameId, pet in pairs(data.Pets) do
            if type(pet) == "table" then
                petKeyMap[gameId] = {
                    name   = tostring(pet.Name or ""),
                    itype  = "Pet",
                    rarity = tostring(pet.Rarity or "Unknown"),
                    year   = tostring(pet.Year or ""),
                    chroma = pet.Chroma == true
                }
            end
        end
    end
end

