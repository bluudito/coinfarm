local function UpdateDashboard()
    MapLabel.Text = "Map: " .. State.MapName
    
    local stateText = State.GameState
    if State.GameState == "Prep" and State.TeleportedToMap then
        stateText = "Prep (On Map)"
    end
    StateLabel.Text = "State: " .. stateText
    
    CoinLabel.Text = "Coins: " .. State.LocalCoins .. " / " .. State.MaxCoins

    for _, child in ipairs(PlayerListFrame:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end

    if State.GameState == "Lobby" then
        PlayerListLabel.Text = "--- Waiting for next round ---"
    else
        PlayerListLabel.Text = "--- Players in Round ---"
        for name, data in pairs(State.PlayersData) do
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 0, 20)
            lbl.BackgroundTransparency = 1
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 13
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            
            local role = data.Role or "Unknown"
            local status = data.Dead and " (Dead)" or ""
            lbl.Text = name .. " - " .. role .. status
            
            if data.Dead then
                lbl.TextColor3 = Color3.fromRGB(120, 120, 120)
            elseif role == "Murderer" then
                lbl.TextColor3 = Color3.fromRGB(255, 50, 50)
            elseif role == "Sheriff" then
                lbl.TextColor3 = Color3.fromRGB(50, 150, 255)
            elseif role == "Innocent" then
                lbl.TextColor3 = Color3.fromRGB(50, 255, 50)
            else
                lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
            lbl.Parent = PlayerListFrame
        end
    end
end

