-- ================= COIN FARM LOOP ================= --
task.spawn(function()
    while ScriptActive do
        task.wait(0.1)
        if not ScriptActive then break end
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChildOfClass("Humanoid") then continue end

        local myData = State.PlayersData[LocalPlayer.Name]
        local myRole = myData and myData.Role
        local isDead = myData and myData.Dead

        if not myData or isDead then
            if wasFarming then
                wasFarming = false
                if noclipActive then setNoclip(false) end
                if reusableBodyVel then reusableBodyVel:Destroy() reusableBodyVel = nil end
            end
            task.wait(0.5)
            continue
        end

        local hrp = char.HumanoidRootPart
        local bagIsFull = State.MaxCoins > 0 and State.LocalCoins >= State.MaxCoins
        local shouldKillAll = State.GameState == "Active" and myRole == "Murderer" and (State.AutoKillAllEnabled or (State.CoinFarmEnabled and bagIsFull))

        if shouldKillAll then
            if noclipActive then setNoclip(false) end
            if reusableBodyVel then reusableBodyVel:Destroy() reusableBodyVel = nil end
            wasFarming = false
            for _, v in ipairs(hrp:GetChildren()) do if v:IsA("BodyPosition") then v:Destroy() end end
            hrp.CFrame = CampCFrame
            local campHold = Instance.new("BodyPosition")
            campHold.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            campHold.P = 10000
            campHold.D = 500
            campHold.Position = CampCFrame.Position
            campHold.Parent = hrp
            while ScriptActive and State.GameState == "Active" do
                local cd = State.PlayersData[LocalPlayer.Name]
                if cd and (cd.Dead or cd.Role ~= "Murderer") then break end
                task.spawn(PerformKillAll)
                task.wait(1)
            end
            campHold:Destroy()
        elseif State.CoinFarmEnabled and (State.GameState == "Active" or (State.GameState == "Prep" and State.TeleportedToMap)) then
            wasFarming = true
            if not noclipActive then setNoclip(true) end
            if State.GameState == "Active" and bagIsFull then
                if myRole == "Innocent" or myRole == nil then
                    if reusableBodyVel then reusableBodyVel:Destroy() reusableBodyVel = nil end
                    for _, v in ipairs(hrp:GetChildren()) do if v:IsA("BodyPosition") then v:Destroy() end end
                    hrp.CFrame = CampCFrame
                    hrp.Anchored = true
                    while ScriptActive and State.GameState == "Active" and State.CoinFarmEnabled do
                        local cd = State.PlayersData[LocalPlayer.Name]
                        if cd and cd.Dead then break end
                        task.wait(1)
                    end
                    if ScriptActive then hrp.Anchored = false end
                elseif myRole == "Sheriff" or myRole == "Hero" then
                    if reusableBodyVel then reusableBodyVel:Destroy() reusableBodyVel = nil end
                    setNoclip(false)
                    char:FindFirstChildOfClass("Humanoid").Health = 0
                    task.wait(2)
                end
            else
                local coin = GetClosestCoin(hrp)
                if coin then
                    local targetPos = Vector3.new(coin.Position.X, coin.Position.Y + State.CoinFarmYOffset, coin.Position.Z)
                    if not reusableBodyVel or not reusableBodyVel.Parent then
                        reusableBodyVel = Instance.new("BodyVelocity")
                        reusableBodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                        reusableBodyVel.Velocity = Vector3.zero
                        reusableBodyVel.Parent = hrp
                    end
                    local reached = false
                    local startTime = tick()
                    while ScriptActive and not reached and coin:IsDescendantOf(Workspace) do
                        if not State.CoinFarmEnabled then reached = true break end
                        local currentMyData = State.PlayersData[LocalPlayer.Name]
                        if currentMyData and currentMyData.Dead then reached = true break end
                        if State.GameState ~= "Active" and State.GameState ~= "Prep" then reached = true break end
                        if State.MaxCoins > 0 and State.LocalCoins >= State.MaxCoins then reached = true break end
                        local dir = targetPos - hrp.Position
                        local dist = dir.Magnitude
                        if dist < 0.5 then
                            reached = true
                        else
                            reusableBodyVel.Velocity = dir.Unit * State.CoinFarmSpeed
                            if tick() - startTime > (dist / State.CoinFarmSpeed) + 3 then reached = true end
                        end
                        task.wait(0)
                    end
                    if not ScriptActive then break end
                    reusableBodyVel.Velocity = Vector3.zero
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    local cd = State.PlayersData[LocalPlayer.Name]
                    local shouldAbort = (not State.CoinFarmEnabled) or (cd and cd.Dead) or (State.GameState ~= "Active" and State.GameState ~= "Prep") or (State.MaxCoins > 0 and State.LocalCoins >= State.MaxCoins)
                    if not shouldAbort then
                        task.wait(0.1)
                        if ScriptActive and coin:IsDescendantOf(Workspace) then
                            pcall(function() firetouchinterest(hrp, coin, 0) end)
                            task.wait(0.05)
                            pcall(function() firetouchinterest(hrp, coin, 1) end)
                        end
                        if not ScriptActive then break end
                        blacklistedCoins[coin] = true
                        local bConn
                        bConn = coin.AncestryChanged:Connect(function()
                            if not coin:IsDescendantOf(Workspace) then
                                blacklistedCoins[coin] = nil
                                if bConn then bConn:Disconnect() blacklistConns[coin] = nil end
                            end
                        end)
                        blacklistConns[coin] = bConn
                        task.delay(5, function()
                            if blacklistedCoins[coin] then
                                blacklistedCoins[coin] = nil
                                if bConn then bConn:Disconnect() blacklistConns[coin] = nil end
                            end
                        end)
                        local waited = 0
                        while ScriptActive and waited < State.CoinFarmCooldown do
                            local cd2 = State.PlayersData[LocalPlayer.Name]
                            if cd2 and cd2.Dead then break end
                            if State.GameState ~= "Active" and State.GameState ~= "Prep" then break end
                            if not State.CoinFarmEnabled then break end
                            if State.MaxCoins > 0 and State.LocalCoins >= State.MaxCoins then break end
                            task.wait(0.1)
                            waited += 0.1
                        end
                    end
                else
                    if not reusableBodyVel or not reusableBodyVel.Parent then
                        reusableBodyVel = Instance.new("BodyVelocity")
                        reusableBodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                        reusableBodyVel.Velocity = Vector3.zero
                        reusableBodyVel.Parent = hrp
                    end
                    if State.GameState == "Prep" and State.TeleportTick > 0 then
                        local elapsed = tick() - State.TeleportTick
                        if elapsed < 1 then task.wait(1 - elapsed) end
                    end
                    if hrp.Position.Y > -10 then lastSafeCFrame = hrp.CFrame end
                    local hidePos = hrp.Position - Vector3.new(0, 6.5, 0)
                    hrp.CFrame = CFrame.new(hidePos)
                    reusableBodyVel.Velocity = Vector3.zero
                    while ScriptActive and not GetClosestCoin(hrp) do
                        local cd = State.PlayersData[LocalPlayer.Name]
                        if cd and cd.Dead then break end
                        if State.GameState ~= "Active" and State.GameState ~= "Prep" then break end
                        if not State.CoinFarmEnabled then break end
                        task.wait(0.1)
                    end
                end
            end
        else
            if noclipActive then setNoclip(false) end
            if reusableBodyVel then reusableBodyVel:Destroy() reusableBodyVel = nil end
            if hrp then
                hrp.Anchored = false
                if wasFarming and State.GameState ~= "Lobby" then
                    if lastSafeCFrame then
                        hrp.CFrame = lastSafeCFrame
                        lastSafeCFrame = nil
                    else
                        hrp.CFrame = hrp.CFrame + Vector3.new(0, 7, 0)
                    end
                end
            end
            wasFarming = false
        end
    end
end)

