local function CloseScript()
    if not ScriptActive then return end
    ScriptActive = false

    -- Clear ESP
    for _, hl in pairs(espObjects) do
        if hl and hl.Parent then hl:Destroy() end
    end
    espObjects = {}

    -- Disconnect all events
    for _, conn in ipairs(connections) do
        if conn and conn.Disconnect then
            conn:Disconnect()
        end
    end

    -- Clean up farm elements
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    
    if reusableBodyVel then
        reusableBodyVel:Destroy()
        reusableBodyVel = nil
    end

    -- Clean up Anti-AFK
    if antiAfkConn then
        antiAfkConn:Disconnect()
        antiAfkConn = nil
    end

    -- Restore character safely
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") then
        c.HumanoidRootPart.Anchored = false
        
        -- Only TP up if the coin farm was switched on (or actively farming) and we are not in the lobby
        if (State.CoinFarmEnabled or wasFarming) and State.GameState ~= "Lobby" then
            c.HumanoidRootPart.CFrame = c.HumanoidRootPart.CFrame + Vector3.new(0, 7, 0)
        end
        
        for _, part in ipairs(c:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
    wasFarming = false

    -- Destroy UI
    if ScreenGui and ScreenGui.Parent then
        ScreenGui:Destroy()
    end
end

