local function setNoclip(enabled)
    if enabled then
        if noclipConnection then return end
        noclipActive = true
        savedCollisions = {}
        noclipConnection = RunService.Stepped:Connect(function()
            if not ScriptActive or not noclipActive then return end
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if savedCollisions[part] == nil then savedCollisions[part] = part.CanCollide end
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        noclipActive = false
        if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = savedCollisions[part] ~= nil and savedCollisions[part] or true
                end
            end
        end
        savedCollisions = {}
    end
end

