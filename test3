local function applyRarityColor(el, rarity)
    if not el then return end
    local rarityColor = getRarityColor(rarity)
    pcall(function()
        if typeof(el) == "Instance" then
            el.BackgroundColor3 = rarityColor
            el.BackgroundTransparency = 0.8
            for _, child in ipairs(el:GetDescendants()) do
                if child:IsA("ImageLabel") and child.Image ~= "" then
                    child.ImageColor3 = rarityColor
                    child.ImageTransparency = 0.8
                elseif child:IsA("Frame") then
                    child.BackgroundColor3 = rarityColor
