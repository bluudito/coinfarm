-- ================= ESP LOGIC ================= --
local function ClearESP()
    for _, hl in pairs(espObjects) do
        if hl and hl.Parent then hl:Destroy() end
    end
    espObjects = {}
end

local function GetRoleColor(role)
    if role == "Murderer" then return Color3.fromRGB(255, 0, 0)
    elseif role == "Sheriff" then return Color3.fromRGB(0, 0, 255)
    elseif role == "Innocent" then return Color3.fromRGB(0, 255, 0)
    else return Color3.fromRGB(255, 255, 255) end
end

table.insert(connections, RunService.RenderStepped:Connect(function()
    if State.ESPEnabled and (State.GameState == "Active" or State.GameState == "Prep") then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local pData = State.PlayersData[player.Name]
                if pData and not pData.Dead and State.ESPRoles[pData.Role] then
                    if not espObjects[player] or not espObjects[player].Parent then
                        local hl = Instance.new("Highlight")
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.Parent = player.Character
                        espObjects[player] = hl
                    end
                    espObjects[player].FillColor = GetRoleColor(pData.Role)
                    espObjects[player].OutlineColor = GetRoleColor(pData.Role)
                else
                    if espObjects[player] then
                        espObjects[player]:Destroy()
                        espObjects[player] = nil
                    end
                end
            else
                if espObjects[player] then
                    espObjects[player]:Destroy()
                    espObjects[player] = nil
                end
            end
        end
    else
        ClearESP()
    end
end))

-- ================= COIN FARM LOGIC (INSTANT HIDE & INSTANT TP) ================= --
local blacklistedCoins = {}
local noclipActive = false

local function setNoclip(enabled)
    if enabled and not noclipConnection then
        noclipActive = true
        noclipConnection = RunService.Stepped:Connect(function()
            if not ScriptActive or not noclipActive then return end
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    elseif not enabled and noclipConnection then
        noclipActive = false
        noclipConnection:Disconnect()
        noclipConnection = nil
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end

local function GetClosestCoin(hrp)
    local map = FindMap()
    if not map then return nil end
    local container = map:FindFirstChild("CoinContainer")
    if not container then return nil end
    
    local closestCoin = nil
    local shortestDist = math.huge
    
    for _, coin in ipairs(container:GetChildren()) do
        if not blacklistedCoins[coin] then
            local coinPart = nil
            if coin:IsA("BasePart") then
                coinPart = coin
            elseif coin:IsA("Model") then
                if coin.PrimaryPart then
                    coinPart = coin.PrimaryPart
                else
                    local ok, cframe = pcall(function() return coin:GetPivot() end)
                    if ok then 
                        coinPart = coin:FindFirstChildWhichIsA("BasePart", true)
                    end
                end
            end
            
            if coinPart then
                local dist = (coinPart.Position - hrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestCoin = coinPart
                end
            end
        end
    end
    return closestCoin
end

-- Logic thread
task.spawn(function()
    while ScriptActive do
        task.wait(0.1)
        if not ScriptActive then break end

        local char = LocalPlayer.Character
        local myData = State.PlayersData[LocalPlayer.Name]
        local myRole = myData and myData.Role
        local isDead = myData and myData.Dead
        
        -- Handle being dead
        if isDead then
            if wasFarming then wasFarming = false end
            if noclipActive then setNoclip(false) end
            if reusableBodyVel then reusableBodyVel:Destroy() reusableBodyVel = nil end
            task.wait(1)
        elseif char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
            local hrp = char.HumanoidRootPart
            local bagIsFull = State.MaxCoins > 0 and State.LocalCoins >= State.MaxCoins
            
            -- 1. KILL ALL LOGIC (Takes Priority if Murderer AND (AutoKill ON OR Bag Full))
            local shouldKillAll = State.GameState == "Active" and myRole == "Murderer" and (State.AutoKillAllEnabled or bagIsFull)
            if shouldKillAll then
                -- Stop farming stuff if we were
                if noclipActive then setNoclip(false) end
                if reusableBodyVel then reusableBodyVel:Destroy() reusableBodyVel = nil end
                wasFarming = false
                
                -- Clear any existing hold positions
                for _, v in ipairs(hrp:GetChildren()) do
                    if v:IsA("BodyPosition") then v:Destroy() end
                end
                
                -- TP to camp
                hrp.CFrame = CampCFrame
                
                -- Use BodyPosition to hold (Anchoring breaks stab)
                local campHold = Instance.new("BodyPosition")
                campHold.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                campHold.P = 10000
                campHold.D = 500
                campHold.Position = CampCFrame.Position
                campHold.Parent = hrp
                
                -- Loop kill all
                while ScriptActive and State.GameState == "Active" and myRole == "Murderer" and not (State.PlayersData[LocalPlayer.Name] and State.PlayersData[LocalPlayer.Name].Dead) do
                    task.spawn(PerformKillAll) -- Run in isolated thread like the manual button!
                    task.wait(1) -- Wait 1 second before doing it again
                end
                
                campHold:Destroy()
                
            -- 2. COIN FARM LOGIC
            elseif State.CoinFarmEnabled and (State.GameState == "Active" or (State.GameState == "Prep" and State.TeleportedToMap)) then
                wasFarming = true
                
                -- Turn on Noclip if we aren't already
                if not noclipActive then setNoclip(true) end
                
                if State.GameState == "Active" and bagIsFull then
                    -- Bag full
                    if myRole == "Innocent" or myRole == nil then
                        -- Instant TP to camp
                        if reusableBodyVel then reusableBodyVel:Destroy() reusableBodyVel = nil end
                        for _, v in ipairs(hrp:GetChildren()) do
                            if v:IsA("BodyPosition") then v:Destroy() end
                        end
                        
                        hrp.CFrame = CampCFrame
                        hrp.Anchored = true
                        
                        while ScriptActive and State.GameState == "Active" and State.CoinFarmEnabled and not (State.PlayersData[LocalPlayer.Name] and State.PlayersData[LocalPlayer.Name].Dead) do
                            task.wait(1)
                        end
                        
                        if ScriptActive then hrp.Anchored = false end
                        
                    elseif myRole == "Sheriff" then
                        if reusableBodyVel then reusableBodyVel:Destroy() reusableBodyVel = nil end
                        setNoclip(false)
                        char:FindFirstChildOfClass("Humanoid").Health = 0
                        task.wait(2)
                    end
                    -- Note: Murderer with full bag is handled by the shouldKillAll block above!
                    
                else
                    -- Bag not full (or no max coins set yet)
                    local coin = GetClosestCoin(hrp)
                    if coin then
                        local targetPos = Vector3.new(coin.Position.X, coin.Position.Y + State.CoinFarmYOffset, coin.Position.Z)
                        
                        -- Clear any hold positions
                        for _, v in ipairs(hrp:GetChildren()) do
                            if v:IsA("BodyPosition") then v:Destroy() end
                        end
                        if not reusableBodyVel or not reusableBodyVel:IsDescendantOf(hrp) then
                            reusableBodyVel = Instance.new("BodyVelocity")
                            reusableBodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                            reusableBodyVel.Velocity = Vector3.zero
                            reusableBodyVel.Parent = hrp
                        end
                        
                        local reached = false
                        local startTime = tick()
                        while ScriptActive and not reached and coin:IsDescendantOf(Workspace) do
                            if not State.CoinFarmEnabled then reached = true break end
                            local currentMyData = State.PlayersData[LocalPlayer.Name]
                            if currentMyData and currentMyData.Dead then reached = true break end
                            if State.GameState ~= "Active" and State.GameState ~= "Prep" then reached = true break end
                            if State.MaxCoins > 0 and State.LocalCoins >= State.MaxCoins then reached = true break end
                            
                            local dir = targetPos - hrp.Position
                            local dist = dir.Magnitude
                            if dist < 0.5 then
                                reached = true
                            else
                                reusableBodyVel.Velocity = dir.Unit * State.CoinFarmSpeed
                                if tick() - startTime > (dist / State.CoinFarmSpeed) + 3 then reached = true end
                            end
                            task.wait()
                        end
                        
                        if not ScriptActive then break end
                        
                        reusableBodyVel.Velocity = Vector3.zero
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        
                        local currentMyData = State.PlayersData[LocalPlayer.Name]
                        local shouldAbort = (not State.CoinFarmEnabled) or (currentMyData and currentMyData.Dead) or (State.GameState ~= "Active" and State.GameState ~= "Prep") or (State.MaxCoins > 0 and State.LocalCoins >= State.MaxCoins)
                        
                        if shouldAbort then
                            -- do nothing
                        else
                            local holdPos = Instance.new("BodyPosition")
                            holdPos.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                            holdPos.P = 10000
                            holdPos.D = 500
                            holdPos.Position = targetPos
                            holdPos.Parent = hrp
                            
                            task.wait(0.1)

                            if ScriptActive and coin:IsDescendantOf(Workspace) then
                                pcall(function() firetouchinterest(hrp, coin, 0) end)
                                task.wait(0.05)
                                pcall(function() firetouchinterest(hrp, coin, 1) end)
                            end

                            if not ScriptActive then break end

                            blacklistedCoins[coin] = true
                            task.delay(2, function() blacklistedCoins[coin] = nil end)
                            
                            local waited = 0
                            while ScriptActive and waited < 0.5 do
                                local cd = State.PlayersData[LocalPlayer.Name]
                                if cd and cd.Dead then break end
                                if State.GameState ~= "Active" and State.GameState ~= "Prep" then break end
                                if not State.CoinFarmEnabled then break end
                                if State.MaxCoins > 0 and State.LocalCoins >= State.MaxCoins then break end
                                task.wait(0.1)
                                waited = waited + 0.1
                            end
                            
                            holdPos:Destroy()
                        end
                    else
                        -- No coin found! Hide 6.5 studs underground
                        if reusableBodyVel then reusableBodyVel:Destroy() reusableBodyVel = nil end
                        
                        if State.GameState == "Prep" and State.TeleportTick > 0 then
                            local timeSinceTeleport = tick() - State.TeleportTick
                            if timeSinceTeleport < 1 then task.wait(1 - timeSinceTeleport) end
                        end
                        
                        local hidePos = hrp.Position - Vector3.new(0, 6.5, 0)
                        hrp.CFrame = CFrame.new(hidePos)
                        
                        local holdPos = Instance.new("BodyPosition")
                        holdPos.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                        holdPos.P = 10000
                        holdPos.D = 500
                        holdPos.Position = hidePos
                        holdPos.Parent = hrp
                        
                        while ScriptActive and not GetClosestCoin(hrp) do
                            local cd = State.PlayersData[LocalPlayer.Name]
                            if cd and cd.Dead then break end
                            if State.GameState ~= "Active" and State.GameState ~= "Prep" then break end
                            if not State.CoinFarmEnabled then break end
                            task.wait(0.1)
                        end
                        
                        holdPos:Destroy()
                    end
                end
            else
                -- Nothing enabled
                if noclipActive then setNoclip(false) end
                if reusableBodyVel then reusableBodyVel:Destroy() reusableBodyVel = nil end
                hrp.Anchored = false
                
                if wasFarming and State.GameState ~= "Lobby" then
                    hrp.CFrame = hrp.CFrame + Vector3.new(0, 7, 0)
                end
                wasFarming = false
            end
        end
    end
end)

