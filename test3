local function getSupremeValue(itemName, itemType, itemRarity, itemYear, isChroma)
    if not itemName or itemName == "" then return nil end
    
    itemName = string.lower(itemName)
    itemType = string.lower(itemType or "Unknown")
    itemRarity = string.lower(itemRarity or "Unknown")
    itemYear = (itemYear == "None" or itemYear == nil) and "" or tostring(itemYear)
    
    local targetRarity = isChroma and "chroma" or itemRarity
    local matches = {}
    
    -- STEP 1: Filter by Name
    for _, item in ipairs(SV_DATA) do
        if string.lower(item.name) == itemName then
            table.insert(matches, item)
        end
    end
    
    if #matches == 0 then return nil end
    if #matches == 1 then return matches[1].value end
    
    -- STEP 2: Filter by Rarity
    local rarityMatches = {}
    for _, item in ipairs(matches) do
        if string.lower(item.rarity) == targetRarity then
            table.insert(rarityMatches, item)
        end
    end
    if #rarityMatches > 0 then matches = rarityMatches end
    if #matches == 1 then return matches[1].value end
    
    -- STEP 3: Filter by Type
    local typeMatches = {}
    for _, item in ipairs(matches) do
        if string.lower(item.type) == itemType then
            table.insert(typeMatches, item)
        end
    end
    if #typeMatches > 0 then matches = typeMatches end
    if #matches == 1 then return matches[1].value end
    
    -- STEP 4: Filter by Year
    local yearMatches = {}
    for _, item in ipairs(matches) do
        if item.year == itemYear then
            table.insert(yearMatches, item)
        end
    end
    if #yearMatches > 0 then matches = yearMatches end
    
    return matches[1].value
end

local function buildItemList(data)
    local items = {}
    local totalNumeric = 0

    local function processCategory(categoryTable, isPet)
        if type(categoryTable) ~= "table" then return end
        local owned = categoryTable.Owned or categoryTable
        
        for id, qty in pairs(owned) do
            local gameData = isPet and petKeyMap[id] or weaponKeyMap[id]
            if gameData then
                local val = getSupremeValue(gameData.name, gameData.itype, gameData.rarity, gameData.year, gameData.chroma)
                
                local displayQty = (type(qty) == "number") and qty or 1
                local displayVal = val
                
                if type(val) == "string" then
                    -- Keep string as is for display
                elseif type(val) == "number" then
                    totalNumeric = totalNumeric + (val * displayQty)
                end
                
                table.insert(items, { 
                    name = gameData.name, 
                    value = displayVal, 
                    rarity = gameData.rarity, 
                    itype = gameData.itype, 
                    chroma = gameData.chroma,
                    qty = displayQty 
                })
            else
                table.insert(items, { 
                    name = tostring(id), 
                    value = nil, 
                    rarity = "Unknown", 
                    itype = isPet and "Pet" or "Unknown", 
                    chroma = false,
                    qty = (type(qty) == "number") and qty or 1 
                })
            end
        end
    end

    if type(data) == "table" then
        processCategory(data.Weapons, false)
        processCategory(data.Pets, true)
    end

    table.sort(items, function(a, b)
        local av = (type(a.value) == "number") and (a.value * a.qty) or -1
        local bv = (type(b.value) == "number") and (b.value * b.qty) or -1
        return av > bv
    end)

    return items, totalNumeric
end

local function fmtVal(n)
    if not n then return "N/A" end
    if type(n) ~= "number" then return tostring(n) end
    if n >= 1000000 then 
        return string.format("%.1fM", n/1000000)
    elseif n >= 1000 then 
        return string.format("%.1fK", n/1000)
    else 
        return tostring(math.floor(n)) 
    end
end

