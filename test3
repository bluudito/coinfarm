-- ================= KILL ALL LOGIC ================= --
local function EquipKnife()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char then return false end
    if char:FindFirstChild("Knife") then return true end
    
    if backpack and backpack:FindFirstChild("Knife") then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:EquipTool(backpack.Knife)
            task.wait() -- Wait a frame for it to fully equip
            return true
        end
    end
    return false
end

local function PerformKillAll()
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    
    -- 1. Equip Knife
    local hasKnife = EquipKnife()
    if not hasKnife then return end
    
    local knife = myChar:FindFirstChild("Knife")
    if not knife then return end
    
    -- 2. Save original positions and targets
    local savedPositions = {}
    local targets = {}
    
    for _, targetPlr in ipairs(Players:GetPlayers()) do
        if targetPlr ~= LocalPlayer and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") then
            local targetHrp = targetPlr.Character.HumanoidRootPart
            savedPositions[targetHrp] = targetHrp.CFrame
            table.insert(targets, targetHrp)
            
            -- Disable collisions locally so they don't push us
            for _, part in ipairs(targetPlr.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
    
    -- 3. HOLD them in front of us while we stab
    local holdingLoop
    holdingLoop = RunService.Heartbeat:Connect(function()
        for _, targetHrp in ipairs(targets) do
            if targetHrp and targetHrp.Parent then
                targetHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, -2)
            end
        end
    end)
    
    -- 4. Trigger the stab (Using VirtualUser bypasses UI completely)
    pcall(function() knife:Activate() end)
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new())
        task.wait(0.1)
        VirtualUser:Button1Up(Vector2.new())
    end)
    
    -- 5. Wait 0.6 seconds for the knife swing animation to actually hit them
    task.wait(0.6)
    
    -- 6. Stop holding them
    holdingLoop:Disconnect()
    
    -- 7. Un-TP them (send them back to where they were)
    for hrp, originalCFrame in pairs(savedPositions) do
        if hrp and hrp.Parent then
            hrp.CFrame = originalCFrame
        end
    end
end

