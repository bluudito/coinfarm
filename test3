local function populateInventoryUI(pName, data)
    clearInventoryUI()
    if InvHeaderPara then InvHeaderPara:SetTitle(pName .. "'s Inventory") end

    local items, total = buildItemList(data)
    if TotalPara then
        TotalPara:SetTitle("Total Value  —  " .. fmtVal(total))
        TotalPara:SetDesc("Numeric items only. Relative-value items shown below.")
    end

    if #items == 0 then
        local el = RightCol:Paragraph({ Title = "No Items Found", Desc = "This player has no items." })
        table.insert(InvElements, el)
        return
    end

    for _, item in ipairs(items) do
        local valStr = "(N/A)"
        if item.value ~= nil then
            if type(item.value) == "number" then
                valStr = "Value: " .. tostring(item.value)
            else
                valStr = "Value: " .. tostring(item.value)
            end
        end

        local typeTag = " [" .. item.itype .. "]"
        if item.chroma then typeTag = " [Chroma" .. (item.itype ~= "Unknown" and " " .. item.itype or "") .. "]" end
        
        local titleStr = string.format("[%dx] %s%s", item.qty, item.name, typeTag)
        local descStr = item.rarity .. "   |   " .. valStr
        
        if type(item.value) == "number" and item.qty > 1 then
            descStr = descStr .. "   |   Total: " .. fmtVal(item.value * item.qty)
        end

        local el = RightCol:Paragraph({ Title = titleStr, Desc = descStr })
        applyRarityColor(el, item.rarity)
        table.insert(InvElements, el)
    end
end

