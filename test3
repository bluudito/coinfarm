-- ================= GAME LOGIC & REMOTES ================= --
local function FindMap()
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("Folder") then
            if obj:FindFirstChild("CoinAreas") or obj:FindFirstChild("CoinContainer") then
                return obj
            end
        end
    end
    return nil
end

table.insert(connections, FadeEvent.OnClientEvent:Connect(function(data)
    State.PlayersData = {}
    if typeof(data) == "table" then
        for _, info in pairs(data) do
            if typeof(info) == "table" and info.UserId then
                local p = Players:GetPlayerByUserId(info.UserId)
                if p then
                    State.PlayersData[p.Name] = { Role = info.Role, Dead = info.Dead }
                end
            end
        end
    end
    
    State.GameState = "Prep"
    State.TeleportedToMap = false
    State.TeleportTick = 0
    State.LocalCoins = 0
    State.MaxCoins = 0
    
    local map = FindMap()
    State.MapName = map and map.Name or "Unknown"
    UpdateDashboard()
end))

