local hooksActive = false

local function initAntiKick()
    local gc  = getfenv().getgc          or getgc
    local hk  = getfenv().hookfunction   or hookfunction
    local nc  = getfenv().newcclosure    or function(f) return f end
    local hm  = getfenv().hookmetamethod or hookmetamethod
    local nm  = getfenv().getnamecallmethod or getnamecallmethod

    local player = game:GetService("Players").LocalPlayer
    local cache  = {}

    local function isUUID(r)
        if cache[r] then return true end
        local n = r.Name
        if #n == 36 and string.match(n, "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$") then
            cache[r] = true
            return true
        end
        return false
    end

    local feHook
    feHook = hk(Instance.new("RemoteEvent").FireServer, function(self, ...)
        if isUUID(self) then return feHook(self, ...) end
        for _, v in ipairs({...}) do
            if type(v) == "string" and string.find(string.lower(v), "kick") then return end
        end
        return feHook(self, ...)
    end)

    local nmHook
    nmHook = hm(game, "__namecall", nc(function(self, ...)
        local method = nm()
        if self == player and (method == "Kick" or method == "kick" or method == "Destroy" or method == "destroy") then return end
        return nmHook(self, ...)
    end))

    local kickHook
    kickHook = hk(player.Kick, nc(function(self, ...)
        if not checkcaller() and self == player then return end
        return kickHook(self, ...)
    end))

    local destHook
    destHook = hk(player.Destroy, nc(function(self, ...)
        if not checkcaller() and self == player then return end
        return destHook(self, ...)
    end))

    pcall(function()
        for _, v in pairs(gc(true)) do
            if type(v) == "table" then
                pcall(function()
                    if rawget(v, "Send") and type(rawget(v, "Send")) == "function" and rawget(v, "Get") and rawget(v, "Encrypt") then
                        local sHook
                        sHook = hk(v.Send, nc(function(cmd, ...)
                            if type(cmd) == "string" then
                                local c = string.lower(cmd)
                                if c == "detected" or c == "logerror" then return end
                            end
                            return sHook(cmd, ...)
                        end))
                    end
                    if rawget(v, "Kill") and type(rawget(v, "Kill")) == "function" and rawget(v, "Disconnect") then
                        hk(v.Kill, nc(function(...) return end))
                        hk(v.Disconnect, nc(function(...) return end))
                    end
                end)
            end
        end
    end)
end

-- ================= COIN FARM ================= --
local function GetClosestCoin(hrp)
    local map = State.MapInstance or FindMap()
    if not map then return nil end
    local container = map:FindFirstChild("CoinContainer")
    if not container then return nil end
    local closestCoin, shortestDist = nil, math.huge
    for _, coin in ipairs(container:GetChildren()) do
        if not blacklistedCoins[coin] then
            local coinPart = nil
            if coin:IsA("BasePart") then
                coinPart = coin
            elseif coin:IsA("Model") then
                coinPart = coin.PrimaryPart
                if not coinPart then
                    local ok, result = pcall(function() return coin:FindFirstChildWhichIsA("BasePart", true) end)
                    if ok then coinPart = result end
                end
            end
            if coinPart then
                local dist = (coinPart.Position - hrp.Position).Magnitude
                if dist < shortestDist then shortestDist = dist closestCoin = coinPart end
            end
        end
    end
    return closestCoin
end

