--// ===== Responsive scaling (only scale, never moves position) =====
local function updateUIPosition()
    local screenSize = camera.ViewportSize
    if screenSize.X <= 0 or screenSize.Y <= 0 then return end

    local currentWidth = expanded and (BASE_WIDTH + SETTINGS_WIDTH) or BASE_WIDTH
    local scale = (screenSize.X * UI_SCALE_FACTOR) / currentWidth
    scale = math.clamp(scale, 0.3, 1.0)
    currentScale = scale
    uiScale.Scale = scale
end

-- Wait a moment so camera is fully initialized on mobile
task.wait(1)
updateUIPosition()
camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateUIPosition)

