-- ================= ROLE TRACKING ================= --
local PlayerRoles = {}

PlayerDataChangedEvent.OnClientEvent:Connect(function(data)
    if typeof(data) == "table" then
        for _, info in pairs(data) do
            if typeof(info) == "table" and info.UserId then
                local p = Players:GetPlayerByUserId(info.UserId)
                if p then
                    PlayerRoles[p.Name] = info.Role
                end
            end
        end
    end
end)

-- ================= VELOCITY HISTORY ================= --
local VelocityHistory = {}
local HISTORY_SIZE = 6

RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            -- Track UpperTorso velocity specifically for torso-aimed prediction
            local torso = player.Character:FindFirstChild("UpperTorso")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local part = torso or hrp
            if part then
                if not VelocityHistory[player] then
                    VelocityHistory[player] = {}
                end
                local buf = VelocityHistory[player]
                table.insert(buf, { v = part.AssemblyLinearVelocity, t = tick() })
                if #buf > HISTORY_SIZE then table.remove(buf, 1) end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    VelocityHistory[p] = nil
    PlayerRoles[p.Name] = nil
end)

-- ================= PING ================= --
local pingHistory = {}
local PING_SAMPLES = 5

local function GetSmoothedPing()
    local raw = 0.1
    pcall(function()
        raw = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    table.insert(pingHistory, raw)
    if #pingHistory > PING_SAMPLES then table.remove(pingHistory, 1) end
    local sum = 0
    for _, v in ipairs(pingHistory) do sum += v end
    return (sum / #pingHistory) / 2
end

-- ================= TARGET ================= --
local function GetMurderer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if PlayerRoles[player.Name] == "Murderer" then return player end
            if PlayerRoles[player.Name] == nil and player.Character:FindFirstChild("Knife") then return player end
        end
    end
    return nil
end

-- ================= GUN ================= --
local function GetShootEvent()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local gun = (backpack and backpack:FindFirstChild("Gun"))
        or (char and char:FindFirstChild("Gun"))
    if gun and gun:FindFirstChild("Shoot") then return gun.Shoot end
    return nil
end

-- ================= PREDICTION — targets UpperTorso ================= --
local function PredictPosition(player, pingInSec)
    local char = player.Character
    if not char then return nil end

    -- Aim at UpperTorso; fall back to LowerTorso, then HumanoidRootPart
    local torso = char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("LowerTorso")
        or char:FindFirstChild("HumanoidRootPart")
    if not torso then return nil end

    local currentPos = torso.Position
    local buf = VelocityHistory[player]

    if not buf or #buf < 2 then
        return currentPos + torso.AssemblyLinearVelocity * (pingInSec + 0.05)
    end

    local avgVel = Vector3.zero
    for _, s in ipairs(buf) do avgVel += s.v end
    avgVel /= #buf

    local totalAcc = Vector3.zero
    local accCount = 0
    for i = 2, #buf do
        local dt = buf[i].t - buf[i-1].t
        if dt > 0 then
            totalAcc += (buf[i].v - buf[i-1].v) / dt
            accCount += 1
        end
    end
    local avgAcc = accCount > 0 and (totalAcc / accCount) or Vector3.zero
    if avgAcc.Magnitude > 200 then avgAcc = avgAcc.Unit * 200 end

    local t = pingInSec + 0.05
    return currentPos + avgVel * t + 0.5 * avgAcc * t * t
end

-- ================= SHOOT ACTION ================= --
local function DoShoot()
    local shootEvent = GetShootEvent()
    if not shootEvent then
        SetStatus("No Gun found", Color3.fromRGB(255, 80, 80))
        return
    end

    local target = GetMurderer()
    if not target then
        SetStatus("No Murderer found", Color3.fromRGB(255, 80, 80))
        return
    end

    local ping = GetSmoothedPing()
    local predicted = PredictPosition(target, ping)
    if not predicted then
        SetStatus("Prediction failed", Color3.fromRGB(255, 80, 80))
        return
    end

    local fakeCamCF = CFrame.new(Camera.CFrame.Position, predicted)
    local fakeHitCF = CFrame.new(predicted)
    shootEvent:FireServer(fakeCamCF, fakeHitCF)
    SetStatus("Fired → " .. target.Name .. string.format(" (ping %.0fms)", ping * 2000), Color3.fromRGB(80, 200, 80))
end

ShootBtn.MouseButton1Click:Connect(DoShoot)

-- ================= INPUT LISTENER ================= --
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed and UserInputService:GetFocusedTextBox() then return end

    if listening then
        if input.UserInputType == Enum.UserInputType.MouseButton1 then return end

        if input.UserInputType == Enum.UserInputType.Keyboard or
           input.UserInputType == Enum.UserInputType.MouseButton2 or
           input.UserInputType == Enum.UserInputType.MouseButton3 then

            boundKey = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode or input.UserInputType
            local label = GetInputLabel(input)

            KeybindBtn.Text = "Keybind: " .. label
            KeybindBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            KeybindBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            listening = false
            SetStatus("Bound to " .. label, Color3.fromRGB(80, 200, 80))
        end
    else
        if boundKey ~= nil then
            local match = false
            if typeof(boundKey) == "EnumItem" then
                if boundKey.EnumType == Enum.KeyCode then
                    match = (input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == boundKey)
                else
                    match = (input.UserInputType == boundKey)
                end
            end
            if match then DoShoot() end
        end
    end
end)

