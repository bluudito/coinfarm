local boundKey = nil
local listening = false

local function GetInputLabel(input)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        return tostring(input.KeyCode):gsub("Enum.KeyCode.", "")
    else
        local names = {
            MouseButton1 = "LMB",
            MouseButton2 = "RMB",
            MouseButton3 = "MMB"
        }
        local t = tostring(input.UserInputType):gsub("Enum.UserInputType.", "")
        return names[t] or t
    end
end

