--// ===== Noclip (Heartbeat loop – sets CanCollide every frame for local player) =====
local function setNoclip(enabled)
    if enabled == noclipActive then return end
    noclipActive = enabled

    if enabled then
        noclipConn = RunService.Heartbeat:Connect(function()
            local char = player.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
        end
        local char = player.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end

--// ===== Cleanup helpers =====
local function cleanupCharacterState()
    setNoclip(false)
    local character = player.Character
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Anchored = false
            hrp.CanCollide = true
        end
    end
    farmingActive = false
    coinBagFull = false
end

--// ===== Coin helpers =====
local function getCoinPositions()
    local coins = {}
    if not CURRENT_MAP_INSTANCE then return coins end
    local coinContainer = CURRENT_MAP_INSTANCE:FindFirstChild(COIN_CONTAINER_NAME)
    if not coinContainer then return coins end
    for _, coin in ipairs(coinContainer:GetChildren()) do
        local pos
        if coin:IsA("BasePart") then
            pos = coin.Position
        elseif coin:IsA("Model") then
            if coin.PrimaryPart then
                pos = coin.PrimaryPart.Position
            else
                local ok, cframe = pcall(function() return coin:GetPivot() end)
                if ok then pos = cframe.Position end
            end
        end
        if pos then
            table.insert(coins, { instance = coin, position = pos })
        end
    end
    return coins
end

--// ===== Teleport to map spawn =====
local function teleportToMapSpawn(map)
    local spawnsFolder = map:FindFirstChild(SPAWNS_FOLDER_NAME)
    if not spawnsFolder then return end
    local spawnParts = spawnsFolder:GetChildren()
    if #spawnParts == 0 then return end
    local chosen = spawnParts[math.random(1, #spawnParts)]
    local character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart")
    local spawnCFrame
    if chosen:IsA("BasePart") then
        spawnCFrame = chosen.CFrame
    elseif chosen:IsA("Model") then
        spawnCFrame = chosen.PrimaryPart and chosen.PrimaryPart.CFrame or chosen:GetPivot()
    end
    if spawnCFrame then
        hrp.CFrame = spawnCFrame + Vector3.new(0, 3, 0)
    end
end

--// ===== Find CoinAreas (map detection) =====
local function findCoinAreas()
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") then
            local areas = child:FindFirstChild(COIN_AREAS_NAME)
            if areas then
                return areas
            end
        end
    end
    return nil
end

--// ===== Coin farming loop (CFrame‑based movement – no physics, goes through terrain) =====
local function farmCoinsOnce(attemptedCoins)
    if not farmingActive then return nil end
    local coins = getCoinPositions()
    if #coins == 0 then return nil end

    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    -- Find nearest un‑attempted coin
    local nearestCoin = nil
    local nearestDist = math.huge
    for _, coinData in ipairs(coins) do
        if coinData.instance and coinData.instance:IsDescendantOf(workspace) then
            if not attemptedCoins[coinData.instance] then
                local dist = (coinData.position - hrp.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearestCoin = coinData
                end
            end
        end
    end

    if not nearestCoin then return nil end

    local currentCoin = nearestCoin.instance
    local targetPos = Vector3.new(nearestCoin.position.X, nearestCoin.position.Y + Y_OFFSET, nearestCoin.position.Z)

    -- Move directly by setting CFrame every frame (ignores physics/terrain)
    local moveConnection
    local reached = false
    moveConnection = RunService.Heartbeat:Connect(function(dt)
        if not farmingActive then
            reached = true
            return
        end
        local dir = targetPos - hrp.Position
        local dist = dir.Magnitude
        if dist < 0.5 then
            reached = true
            return
        end
        local step = math.min(WALKSPEED * dt, dist) -- smooth step
        hrp.CFrame = hrp.CFrame + dir.Unit * step
    end)

    -- Wait until we reach the coin or something interrupts
    while farmingActive and not reached and currentCoin:IsDescendantOf(workspace) do
        if coinBagFull then
            moveConnection:Disconnect()
            return "full"
        end
        task.wait()
    end
    moveConnection:Disconnect()

    if not farmingActive then return nil end
    if coinBagFull then return "full" end

    -- Hold position at the coin
    hrp.CFrame = CFrame.new(targetPos)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    if COOLDOWN_DELAY > 0 then
        local waited = 0
        while waited < COOLDOWN_DELAY do
            if not farmingActive or not active then return nil end
            if coinBagFull then return "full" end
            task.wait(0.1)
            waited = waited + 0.1
        end
    end

    -- Fire touch interest
    if currentCoin:IsDescendantOf(workspace) then
        hrp.CFrame = CFrame.new(targetPos)  -- ensure still there
        pcall(function() firetouchinterest(hrp, currentCoin, 0) end)
        task.wait(0.05)
        pcall(function() firetouchinterest(hrp, currentCoin, 1) end)
    end

    attemptedCoins[currentCoin] = true
    return nil
end

--// ===== CoinCollected event handler =====
CoinCollectedEvent.OnClientEvent:Connect(function(coinName, count, max, extra)
    currentCoinCount = count
    if maxCoinCapacity == nil then maxCoinCapacity = max end
    if count >= max then
        coinBagFull = true
    end
end)

--// ===== Role-based actions =====
local function performRoleAction()
    if not farmingActive then return end
    farmingActive = false
    setNoclip(false)

    if myRole == "Innocent" then
        local character = player.Character
        if character then
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = LOBBY_CFRAME
                hrp.Anchored = true
                hrp.CanCollide = false
            end
        end
        warn("[CoinTP] Innocent – camping at lobby until game ends.")
    else
        local character = player.Character
        if character then
            character:BreakJoints()
        end
        warn("[CoinTP] " .. (myRole or "Unknown") .. " – character reset.")
    end
end

--// ===== Main sequence =====
local function runSequence()
    currentLoopId = currentLoopId + 1
    local myLoopId = currentLoopId

    task.spawn(function()
        while active and scriptActive and myLoopId == currentLoopId do
            local success, fadeData = pcall(function() return FadeEvent.OnClientEvent:Wait() end)
            if not success or not active or not scriptActive or myLoopId ~= currentLoopId then break end

            serverPlayersData = fadeData or {}
            myRole = nil
            if serverPlayersData[player.Name] then
                myRole = serverPlayersData[player.Name].Role
            end
            warn("[CoinTP] Game started, my role: " .. tostring(myRole))

            local coinAreas = nil
            local startWait = tick()
            while not coinAreas and active and scriptActive and myLoopId == currentLoopId do
                coinAreas = findCoinAreas()
                if not coinAreas then
                    task.wait(0.2)
                    if tick() - startWait > 15 then
                        warn("[CoinTP] Timed out waiting for CoinAreas")
                        break
                    end
                end
            end

            if coinAreas then
                local map = coinAreas.Parent
                CURRENT_MAP_INSTANCE = map
                warn("[CoinTP] Map found: " .. map.Name)

                local coinContainer = nil
                startWait = tick()
                while not coinContainer and active and scriptActive and myLoopId == currentLoopId do
                    coinContainer = map:FindFirstChild(COIN_CONTAINER_NAME)
                    if not coinContainer then
                        task.wait(0.2)
                        if tick() - startWait > 20 then
                            warn("[CoinTP] Timed out waiting for CoinContainer")
                            break
                        end
                    end
                end

                if coinContainer then
                    local character = player.Character
                    if character then
                        local hrp = character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            hrp.Anchored = false
                            hrp.CanCollide = true
                        end
                    end

                    teleportToMapSpawn(map)

                    setNoclip(true)
                    farmingActive = true
                    coinBagFull = false
                    currentCoinCount = 0
                    maxCoinCapacity = nil

                    local attemptedCoins = {}
                    local gameEnded = false
                    local breakReason = nil

                    local clear1v1Connection
                    clear1v1Connection = Clear1v1Event.OnClientEvent:Connect(function()
                        gameEnded = true
                    end)

                    while farmingActive and active and scriptActive and myLoopId == currentLoopId do
                        if not CURRENT_MAP_INSTANCE or not CURRENT_MAP_INSTANCE:IsDescendantOf(workspace) then
                            breakReason = "mapgone"
                            break
                        end

                        if coinBagFull then
                            performRoleAction()
                            breakReason = "full"
                            break
                        end

                        if gameEnded then
                            task.wait(0.2)
                            if not CURRENT_MAP_INSTANCE or not CURRENT_MAP_INSTANCE:IsDescendantOf(workspace) then
                                breakReason = "clear1v1"
                                break
                            else
                                gameEnded = false
                            end
                        end

                        local coinPositions = getCoinPositions()
                        if #coinPositions == 0 then
                            task.wait(COIN_POLL_DELAY)
                        else
                            local result = farmCoinsOnce(attemptedCoins)
                            if result == "full" then
                                performRoleAction()
                                breakReason = "full"
                                break
                            end
                            if result == nil then
                                task.wait(COIN_POLL_DELAY)
                            end
                        end
                    end

                    if clear1v1Connection then
                        clear1v1Connection:Disconnect()
                        clear1v1Connection = nil
                    end

                    if breakReason == "full" and myRole == "Innocent" then
                        farmingActive = false
                        coinBagFull = false
                    else
                        cleanupCharacterState()
                    end
                end
            else
                warn("[CoinTP] Round skipped – no CoinAreas found")
                cleanupCharacterState()
            end

            CURRENT_MAP_INSTANCE = nil
            myRole = nil
            farmingActive = false
            coinBagFull = false
        end
    end)
end

